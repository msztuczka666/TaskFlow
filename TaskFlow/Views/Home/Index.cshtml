@model TaskFlow.ViewModels.DziennikGodzinViewModel
@{
    ViewData["Title"] = "Dziennik Godzin";
    Layout = "_DashboardLayout";
}

@if (User.Identity?.IsAuthenticated ?? false)
{
    <!-- TOP SECTION -->
    <div class="top-section">
        <div class="controls-row">
            <div class="date-controls">
                <a href="@Url.Action("Index", new { data = Model.WybranaData.AddDays(-1) })" class="date-button">◀ Wczoraj</a>
                <div class="date-display">@Model.WybranaData.ToString("dd MMMM yyyy") • @Model.WybranaData.ToString("dddd")</div>
                <a href="@Url.Action("Index", new { data = Model.WybranaData.AddDays(1) })" class="date-button">Jutro ▶</a>
            </div>
            <div style="flex: 1;"></div>
            <div class="status-badge">
                <div class="status-dot"></div>
                Zapisane
            </div>
            <div class="action-buttons">
                <button class="btn btn-secondary">⬇️ Z wczoraj</button>
                <button class="btn btn-secondary">📋 Szablon</button>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        
        <!-- SUMMARY -->
        <div class="summary-box">
            <div class="summary-item">
                <label>Pracowników</label>
                <value>@Model.Podsumowanie.LiczbaPracownikow</value>
            </div>
            <div class="summary-item">
                <label>Razem godzin</label>
                <value>@string.Format("{0:0}:{1:00}", Math.Floor(Model.Podsumowanie.RazemGodzin), (Model.Podsumowanie.RazemGodzin % 1) * 60)</value>
            </div>
            <div class="summary-item">
                <label>Nadgodziny</label>
                <value>@string.Format("{0:0}:{1:00}", Math.Floor(Model.Podsumowanie.Nadgodziny), (Model.Podsumowanie.Nadgodziny % 1) * 60)</value>
            </div>
            <div class="summary-item">
                <label>Do rozliczenia</label>
                <value>@string.Format("{0:0}:{1:00}", Math.Floor(Model.Podsumowanie.DoRozliczenia), (Model.Podsumowanie.DoRozliczenia % 1) * 60)</value>
            </div>
        </div>

        <!-- WORKERS -->
        <div class="worker-cards">
            @foreach (var pracownik in Model.Pracownicy)
            {
                <div class="worker-card">
                    <div class="worker-header">
                        <div class="worker-name">
                            <div class="worker-avatar">@pracownik.Inicjaly</div>
                            <div class="worker-info">
                                <h3>@pracownik.Imie @pracownik.Nazwisko</h3>
                                <p>@pracownik.Firma • @pracownik.FirmaId • @pracownik.Stanowisko</p>
                            </div>
                        </div>
                        <div class="worker-summary">
                            <div class="worker-summary-item">
                                <span>Razem</span>
                                <strong>@string.Format("{0:0}:{1:00}", Math.Floor(pracownik.SumaGodzin), (pracownik.SumaGodzin % 1) * 60)</strong>
                            </div>
                            <div class="worker-summary-item">
                                <span>Nadgodziny</span>
                                <strong>@string.Format("{0:0}:{1:00}", Math.Floor(pracownik.SumaNadgodzin), (pracownik.SumaNadgodzin % 1) * 60)</strong>
                            </div>
                        </div>
                    </div>
                    <div class="worker-content">
                        @if (pracownik.Segmenty.Any())
                        {
                            @foreach (var segment in pracownik.Segmenty)
                            {
                                <div class="segment @(segment.CzyNadgodziny ? "overtime" : "")">
                                    <div class="form-group">
                                        <label>Od</label>
                                        <input type="time" value="@segment.GodzinaOd.ToString(@"hh\:mm")" />
                                    </div>
                                    <div class="form-group">
                                        <label>Do</label>
                                        <input type="time" value="@segment.GodzinaDo.ToString(@"hh\:mm")" />
                                    </div>
                                    <div class="form-group">
                                        <label>Zlecenie</label>
                                        <select>
                                            @foreach (var zlecenie in Model.DostepneZlecenia)
                                            {
                                                var isSelected = zlecenie.Id == segment.ZlecenieId;
                                                <option value="@zlecenie.Id" selected="@isSelected">
                                                    @zlecenie.NrZlecenia • @zlecenie.Opis
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Prace</label>
                                        <textarea>@segment.OpisPrac</textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>Godziny</label>
                                        <input type="text" value="@string.Format("{0:0}:{1:00}", Math.Floor(segment.LiczbaGodzin), (segment.LiczbaGodzin % 1) * 60)" disabled />
                                    </div>
                                    <div class="segment-actions">
                                        <button class="icon-btn">📋</button>
                                        <button class="icon-btn delete">✕</button>
                                    </div>
                                </div>
                            }
                        }
                        <button class="add-segment-btn">+ Dodaj kolejny segment (jeśli potrzeba)</button>
                    </div>
                </div>
            }
        </div>

    </div>

    <!-- FOOTER -->
    <div class="footer">
        <div class="footer-left">
            Ostatnia zmiana: <strong>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</strong> • @User.Identity.Name
        </div>
        <div class="footer-center">
            System stworzony przez <a href="#">Mariusz Sztuczka</a> © 2025
        </div>
        <div class="footer-right">
            <button class="btn-cancel">Anuluj</button>
            <button class="btn-save">✓ Zapisz dzień</button>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12 text-center">
            <div class="jumbotron">
                <h2>Witaj w systemie TaskFlow</h2>
                <p class="lead">System zarządzania zleceniami, czasem i frekwencją pracowników</p>
                <hr class="my-4">
                <p>Zaloguj się, aby uzyskać dostęp do systemu</p>
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" role="button">Zaloguj się</a>
            </div>
        </div>
    </div>
}
