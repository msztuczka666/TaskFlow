@inject Microsoft.AspNetCore.Identity.UserManager<TaskFlow.Models.ApplicationUser> UserManager
@model TaskFlow.ViewModels.DziennikGodzinViewModel
@{
    ViewData["Title"] = "Dziennik Godzin";
    Layout = "_Layout";
    var wybranaDataStr = Model.WybranaData.ToString("yyyy-MM-dd");
    var poprzedniDzienStr = Model.WybranaData.AddDays(-1).ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

@if (User.Identity?.IsAuthenticated ?? false)
{
    <!-- TOP SECTION -->
    <div class="top-section">
        <!-- Current Date/Time Display -->
        <div class="current-datetime">
            <div class="current-date" id="currentDate"></div>
            <div class="current-time" id="currentTime"></div>
            <div class="elephant-day" id="elephantDay" style="display: none; margin-top: 8px; font-size: 16px; font-weight: 600; color: #f59e0b;">
                🐘 Dzień „Słonia" 🐘
            </div>
        </div>

        <div class="controls-row">
            <div class="date-controls">
                <a href="@Url.Action("Index", new { data = Model.WybranaData.AddDays(-1) })" class="date-button">◀ Wczoraj</a>
                <div class="date-display">
                    <input type="date" id="selectedDate" value="@wybranaDataStr" class="date-picker" />
                    <span class="day-name">@Model.WybranaData.ToString("dddd")</span>
                </div>
                <a href="@Url.Action("Index", new { data = Model.WybranaData.AddDays(1) })" class="date-button">Jutro ▶</a>
            </div>
            <div style="flex: 1;"></div>
            <div class="status-badge" id="statusBadge">
                <div class="status-dot"></div>
                <span id="statusText">Zapisany</span>
            </div>
            <div class="action-buttons">
                <button class="btn btn-secondary" id="copyFromPreviousBtn" onclick="copyFromPreviousDay()">📥 Skopiuj z dnia poprzedniego</button>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        
        <!-- SUMMARY -->
        <div class="summary-box">
            <div class="summary-item">
                <label>Ilość pracowników</label>
                <value id="statPracownikow">0</value>
            </div>
            <div class="summary-item">
                <label>Razem godzin</label>
                <value id="statGodzin">0:00</value>
            </div>
            <div class="summary-item">
                <label>Razem nadgodzin</label>
                <value id="statNadgodzin">0:00</value>
            </div>
        </div>

        <!-- TIME ENTRIES FORM -->
        <div class="entries-container" id="entriesContainer">
            <!-- Dynamic entries will be added here -->
        </div>

        <button class="add-entry-btn" id="addEntryBtn" onclick="addEntry()">+ Kolejna praca</button>

    </div>

    <!-- FOOTER -->
    <div class="footer">
        <div class="footer-left">
            @{
                var currentUser = await UserManager.GetUserAsync(User);
                var lastChangeUser = currentUser != null && !string.IsNullOrEmpty(currentUser.Imie) && !string.IsNullOrEmpty(currentUser.Nazwisko)
                    ? $"{currentUser.Imie} {currentUser.Nazwisko}"
                    : User.Identity.Name;
            }
            Ostatnia zmiana: <strong>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</strong> - @lastChangeUser
        </div>
        <div class="footer-right">
            <button class="btn-cancel" onclick="cancelChanges()">Anuluj</button>
            <button class="btn-save" onclick="saveDay()">✓ Zapisz</button>
        </div>
    </div>

    <!-- JavaScript for Dynamic Functionality -->
    <script>
        // Data from server
        const selectedDate = '@wybranaDataStr';
        const previousDate = '@poprzedniDzienStr';
        const pracownicy = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pracownicy.Select(p => new { 
            Id = p.PracownikId, 
            Imie = p.Imie, 
            Nazwisko = p.Nazwisko,
            Firma = p.Firma,
            FirmaId = p.FirmaId,
            Stanowisko = p.Stanowisko
        })));
        const zlecenia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DostepneZlecenia.Select(z => new { 
            Id = z.Id, 
            NrZlecenia = z.NrZlecenia, 
            Opis = z.Opis 
        })));
        const existingEntries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pracownicy.SelectMany(p => p.Segmenty.Select(s => new {
            Id = s.Id,
            PracownikId = p.PracownikId,
            GodzinaOd = s.GodzinaOd.ToString(@"hh\:mm"),
            GodzinaDo = s.GodzinaDo.ToString(@"hh\:mm"),
            ZlecenieId = s.ZlecenieId,
            OpisPrac = s.OpisPrac
        }))));

        let entries = [];
        let isDirty = false;
        let entryIdCounter = 1;

        // Generate time options (every 30 minutes from 00:00 to 24:00)
        function generateTimeOptions() {
            const options = [];
            for (let h = 0; h <= 24; h++) {
                for (let m = 0; m < 60; m += 30) {
                    if (h === 24 && m > 0) break;      // Stop after 24:00
                    const hour = h.toString().padStart(2, '0');
                    const minute = m.toString().padStart(2, '0');
                    options.push(`${hour}:${minute}`);
                }
            }
            return options;
        }

        const timeOptions = generateTimeOptions();

        // Update real-time clock
        function updateClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('currentDate').textContent = now.toLocaleDateString('pl-PL', options);
            document.getElementById('currentTime').textContent = now.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
            
            // Check if it's first Thursday of the month
            checkElephantDay(now);
        }
        
        // Check if today is first Thursday of the month (Elephant Day)
        function checkElephantDay(date) {
            const dayOfWeek = date.getDay(); // 0 = Sunday, 4 = Thursday
            const dayOfMonth = date.getDate();
            
            // Check if it's Thursday (4) and it's between 1st and 7th (first week)
            if (dayOfWeek === 4 && dayOfMonth >= 1 && dayOfMonth <= 7) {
                document.getElementById('elephantDay').style.display = 'block';
            } else {
                document.getElementById('elephantDay').style.display = 'none';
            }
        }

        setInterval(updateClock, 1000);
        updateClock();

        // Date picker change handler
        document.getElementById('selectedDate').addEventListener('change', function() {
            window.location.href = '@Url.Action("Index")?data=' + this.value;
        });

        // Initialize with existing entries
        function init() {
            if (existingEntries && existingEntries.length > 0) {
                entries = existingEntries.map((e, index) => ({
                    id: e.Id || (1000 + index),
                    pracownikId: e.PracownikId,
                    godzinaOd: e.GodzinaOd,
                    godzinaDo: e.GodzinaDo,
                    zlecenieId: e.ZlecenieId,
                    opisPrac: e.OpisPrac || ''
                }));
                entryIdCounter = Math.max(...entries.map(e => e.id)) + 1;
                renderEntries();
                updateStatistics();
            } else {
                // Start with empty day (no entries)
                entries = [];
                renderEntries();
                updateStatistics();
            }
        }

        // Add new entry
        function addEntry() {
            const entry = {
                id: entryIdCounter++,
                pracownikId: pracownicy.length > 0 ? pracownicy[0].Id : null,
                godzinaOd: '06:30',
                godzinaDo: '14:30',
                zlecenieId: zlecenia.length > 0 ? zlecenia[0].Id : null,
                opisPrac: ''
            };
            entries.push(entry);
            renderEntries();
            updateStatistics();
            markAsDirty();
        }

        // Remove entry
        function removeEntry(id) {
            entries = entries.filter(e => e.id !== id);
            renderEntries();
            updateStatistics();
            markAsDirty();
        }

        // Calculate hours between two times
        function calculateHours(godzinaOd, godzinaDo) {
            if (!godzinaOd || !godzinaDo) return { total: 0, regular: 0, overtime: 0 };

            const [h1, m1] = godzinaOd.split(':').map(Number);
            const [h2, m2] = godzinaDo.split(':').map(Number);
            
            const minutesFrom = h1 * 60 + m1;
            const minutesTo = h2 * 60 + m2;
            const totalMinutes = minutesTo - minutesFrom;

            if (totalMinutes <= 0) return { total: 0, regular: 0, overtime: 0 };

            const total = totalMinutes / 60;

            // Regular hours: 6:30 - 14:30 (8 hours)
            // Overtime: 00:00 - 6:30 and 14:30 - 24:00
            const regularStartMinutes = 6 * 60 + 30; // 6:30
            const regularEndMinutes = 14 * 60 + 30; // 14:30

            let regularMinutes = 0;
            let overtimeMinutes = 0;

            // Check if work is before regular hours (00:00 - 6:30)
            if (minutesTo <= regularStartMinutes) {
                // All work is overtime (early morning)
                overtimeMinutes = totalMinutes;
            } else if (minutesFrom >= regularEndMinutes) {
                // All work is overtime (after 14:30)
                overtimeMinutes = totalMinutes;
            } else if (minutesFrom < regularStartMinutes && minutesTo > regularStartMinutes) {
                // Work spans early morning overtime and regular hours
                if (minutesTo <= regularEndMinutes) {
                    // Ends within regular hours
                    overtimeMinutes = regularStartMinutes - minutesFrom;
                    regularMinutes = minutesTo - regularStartMinutes;
                } else {
                    // Spans early morning, regular, and late overtime
                    overtimeMinutes = (regularStartMinutes - minutesFrom) + (minutesTo - regularEndMinutes);
                    regularMinutes = regularEndMinutes - regularStartMinutes;
                }
            } else if (minutesFrom >= regularStartMinutes && minutesFrom < regularEndMinutes) {
                // Work starts within regular hours
                if (minutesTo <= regularEndMinutes) {
                    // All within regular hours
                    regularMinutes = totalMinutes;
                } else {
                    // Spans regular and late overtime
                    regularMinutes = regularEndMinutes - minutesFrom;
                    overtimeMinutes = minutesTo - regularEndMinutes;
                }
            }

            return {
                total: total,
                regular: regularMinutes / 60,
                overtime: overtimeMinutes / 60
            };
        }

        // Format hours for display
        function formatHours(hours) {
            const h = Math.floor(hours);
            const m = Math.round((hours - h) * 60);
            return `${h}:${m.toString().padStart(2, '0')}`;
        }

        // Render all entries
        function renderEntries() {
            const container = document.getElementById('entriesContainer');
            container.innerHTML = '';

            entries.forEach((entry, index) => {
                const hours = calculateHours(entry.godzinaOd, entry.godzinaDo);
                const isOvertime = hours.overtime > 0;
                const totalHours = hours.total;
                
                // Determine row highlighting class based on hours worked
                let rowClass = 'entry-row';
                if (totalHours < 8) {
                    rowClass += ' hours-under-8';  // Orange
                } else if (totalHours > 8) {
                    rowClass += ' hours-over-8';   // Red
                }
                // If exactly 8 hours, no special class (normal)

                const entryDiv = document.createElement('div');
                entryDiv.className = rowClass;
                entryDiv.innerHTML = `
                    <div class="form-group">
                        <label>Pracownik</label>
                        <select onchange="updateEntry(${entry.id}, 'pracownikId', parseInt(this.value))">
                            ${pracownicy.map(p => `<option value="${p.Id}" ${p.Id === entry.pracownikId ? 'selected' : ''}>${p.Imie} ${p.Nazwisko}</option>`).join('')}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Godzina od</label>
                        <select onchange="updateEntry(${entry.id}, 'godzinaOd', this.value)">
                            ${timeOptions.map(t => `<option value="${t}" ${t === entry.godzinaOd ? 'selected' : ''}>${t}</option>`).join('')}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Godzina do</label>
                        <select onchange="updateEntry(${entry.id}, 'godzinaDo', this.value)">
                            ${timeOptions.map(t => `<option value="${t}" ${t === entry.godzinaDo ? 'selected' : ''}>${t}</option>`).join('')}
                        </select>
                    </div>
                    <div class="form-group form-group-wide">
                        <label>Zlecenie</label>
                        <select onchange="updateEntry(${entry.id}, 'zlecenieId', parseInt(this.value))">
                            ${zlecenia.map(z => {
                                const fullText = `${z.NrZlecenia} - ${z.Opis}`;
                                const displayText = fullText.length > 60 ? fullText.substring(0, 60) + '...' : fullText;
                                return `<option value="${z.Id}" ${z.Id === entry.zlecenieId ? 'selected' : ''} title="${fullText}">${displayText}</option>`;
                            }).join('')}
                        </select>
                    </div>
                    <div class="form-group form-group-wide">
                        <label>Prowadzone prace</label>
                        <input type="text" value="${entry.opisPrac || ''}" 
                               onchange="updateEntry(${entry.id}, 'opisPrac', this.value)" 
                               placeholder="Opis wykonywanych prac..." />
                    </div>
                    <div class="form-group form-group-small">
                        <label>Godzin</label>
                        <input type="text" value="${formatHours(hours.total)}" disabled class="hours-display" />
                    </div>
                    <div class="entry-actions">
                        <button class="icon-btn delete" onclick="removeEntry(${entry.id})" title="Usuń">✕</button>
                    </div>
                `;
                container.appendChild(entryDiv);
            });
        }

        // Update entry field
        function updateEntry(id, field, value) {
            const entry = entries.find(e => e.id === id);
            if (entry) {
                entry[field] = value;
                renderEntries();
                updateStatistics();
                markAsDirty();
            }
        }

        // Update statistics
        function updateStatistics() {
            let uniquePracownicy = new Set();
            let totalRegular = 0;
            let totalOvertime = 0;

            entries.forEach(entry => {
                if (entry.pracownikId) {
                    uniquePracownicy.add(entry.pracownikId);
                }
                const hours = calculateHours(entry.godzinaOd, entry.godzinaDo);
                totalRegular += hours.regular;
                totalOvertime += hours.overtime;
            });

            document.getElementById('statPracownikow').textContent = uniquePracownicy.size;
            document.getElementById('statGodzin').textContent = formatHours(totalRegular);
            document.getElementById('statNadgodzin').textContent = formatHours(totalOvertime);
        }

        // Mark as dirty (edited)
        function markAsDirty() {
            isDirty = true;
            const badge = document.getElementById('statusBadge');
            const statusText = document.getElementById('statusText');
            badge.className = 'status-badge status-edited';
            statusText.textContent = 'Edytowany';
        }

        // Mark as saved
        function markAsSaved() {
            isDirty = false;
            const badge = document.getElementById('statusBadge');
            const statusText = document.getElementById('statusText');
            badge.className = 'status-badge';
            statusText.textContent = 'Zapisany';
        }

        // Save day
        async function saveDay() {
            try {
                const dataToSave = {
                    data: selectedDate,
                    entries: entries.map(e => ({
                        pracownikId: e.pracownikId,
                        godzinaOd: e.godzinaOd,
                        godzinaDo: e.godzinaDo,
                        zlecenieId: e.zlecenieId,
                        opisPrac: e.opisPrac || ''
                    }))
                };

                const response = await fetch('@Url.Action("SaveDay")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dataToSave)
                });

                if (response.ok) {
                    markAsSaved();
                    alert('Dzień został zapisany!');
                } else {
                    alert('Błąd podczas zapisywania!');
                }
            } catch (error) {
                console.error('Error saving day:', error);
                alert('Błąd podczas zapisywania!');
            }
        }

        // Cancel changes
        function cancelChanges() {
            if (isDirty && !confirm('Czy na pewno chcesz anulować zmiany?')) {
                return;
            }
            location.reload();
        }

        // Copy from previous day
        async function copyFromPreviousDay() {
            if (entries.length > 0 && !confirm('To nadpisze obecne wpisy. Kontynuować?')) {
                return;
            }

            try {
                // Search backwards up to 14 days to find a day with data
                let foundData = false;
                let searchDate = new Date(previousDate);
                const maxDaysBack = 14;
                
                for (let i = 0; i < maxDaysBack && !foundData; i++) {
                    const searchDateStr = searchDate.toISOString().split('T')[0];
                    const response = await fetch(`@Url.Action("GetDayEntries")?data=${searchDateStr}`);
                    const data = await response.json();

                    if (data && data.length > 0) {
                        entries = data.map((e, index) => ({
                            id: entryIdCounter++,
                            pracownikId: e.pracownikId,
                            godzinaOd: e.godzinaOd,
                            godzinaDo: e.godzinaDo,
                            zlecenieId: e.zlecenieId,
                            opisPrac: e.opisPrac || ''
                        }));
                        renderEntries();
                        updateStatistics();
                        markAsDirty();
                        
                        const daysDiff = i + 1;
                        const dayLabel = daysDiff === 1 ? 'poprzedniego dnia' : `${daysDiff} dni wstecz`;
                        alert(`Skopiowano wpisy z ${dayLabel} (${searchDateStr})!`);
                        foundData = true;
                    } else {
                        // Go back one more day
                        searchDate.setDate(searchDate.getDate() - 1);
                    }
                }
                
                if (!foundData) {
                    alert(`Brak wpisów w ostatnich ${maxDaysBack} dniach.`);
                }
            } catch (error) {
                console.error('Error copying from previous day:', error);
                alert('Błąd podczas kopiowania!');
            }
        }

        // Warn before leaving if there are unsaved changes
        window.addEventListener('beforeunload', function (e) {
            if (isDirty) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', init);
    </script>
}
else
{
    <div class="row">
        <div class="col-12 text-center">
            <div class="jumbotron">
                <h2>Witaj w systemie TaskFlow</h2>
                <p class="lead">System zarządzania zleceniami, czasem i frekwencją pracowników</p>
                <hr class="my-4">
                <p>Zaloguj się, aby uzyskać dostęp do systemu</p>
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" role="button">Zaloguj się</a>
            </div>
        </div>
    </div>
}
