@{
    ViewData["Title"] = "Witaj w systemie TaskFlow";
}

@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Pracownicy</h5>
                    <p class="card-text display-6">@ViewBag.TotalPracownicy</p>
                    <a asp-controller="Pracownicy" asp-action="Index" class="btn btn-light btn-sm">Zobacz listę</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Zlecenia</h5>
                    <p class="card-text display-6">@ViewBag.TotalZlecenia</p>
                    <a asp-controller="Zlecenia" asp-action="Index" class="btn btn-light btn-sm">Zobacz listę</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Aktywne Zlecenia</h5>
                    <p class="card-text display-6">@ViewBag.AktywneZlecenia</p>
                    <a asp-controller="Zlecenia" asp-action="Index" class="btn btn-light btn-sm">Zobacz</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Ostrzeżenia SEP</h5>
                    <p class="card-text display-6">@ViewBag.SEPWarnings.Count</p>
                    <a asp-controller="Reports" asp-action="SEPExpiryWarnings" class="btn btn-light btn-sm">Zobacz</a>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.SEPWarnings.Count > 0)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Ostrzeżenia - wygasające certyfikaty SEP (30 dni)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Pracownik</th>
                                        <th>Data wygaśnięcia</th>
                                        <th>Dni do wygaśnięcia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pracownik in ViewBag.SEPWarnings)
                                    {
                                        <tr>
                                            <td>@pracownik.Imie @pracownik.Nazwisko</td>
                                            <td>@pracownik.DataWaznosciSEP?.ToString("dd.MM.yyyy")</td>
                                            <td>
                                                <span class="badge bg-warning text-dark">@pracownik.DniDoWygasniecia dni</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Ostatnie nieobecności</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentNieobecnosci.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Pracownik</th>
                                        <th>Typ</th>
                                        <th>Data od</th>
                                        <th>Data do</th>
                                        <th>Dni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var nieobecnosc in ViewBag.RecentNieobecnosci)
                                    {
                                        <tr>
                                            <td>@nieobecnosc.Pracownik.Imie @nieobecnosc.Pracownik.Nazwisko</td>
                                            <td><span class="badge bg-secondary">@nieobecnosc.TypNieobecnosci</span></td>
                                            <td>@nieobecnosc.DataOd.ToString("dd.MM.yyyy")</td>
                                            <td>@nieobecnosc.DataDo.ToString("dd.MM.yyyy")</td>
                                            <td>@nieobecnosc.LiczbaDni</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a asp-controller="Nieobecnosci" asp-action="Index" class="btn btn-primary btn-sm">Zobacz wszystkie</a>
                    }
                    else
                    {
                        <p class="text-muted">Brak nieobecności</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12 text-center">
            <div class="jumbotron">
                <h2>Witaj w systemie TaskFlow</h2>
                <p class="lead">System zarządzania zleceniami, czasem i frekwencją pracowników</p>
                <hr class="my-4">
                <p>Zaloguj się, aby uzyskać dostęp do systemu</p>
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" role="button">Zaloguj się</a>
            </div>
        </div>
    </div>
}
