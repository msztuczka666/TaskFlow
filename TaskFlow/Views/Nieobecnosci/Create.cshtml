@model TaskFlow.Models.Nieobecnosc
@{
    ViewData["Title"] = "Dodaj nieobecność";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="PracownikId" class="form-label">Pracownik <span class="text-danger">*</span></label>
                <select asp-for="PracownikId" class="form-select" asp-items="@(ViewData["PracownikId"] as SelectList)">
                    <option value="">-- Wybierz pracownika --</option>
                </select>
                <span asp-validation-for="PracownikId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TypNieobecnosci" class="form-label">Typ nieobecności <span class="text-danger">*</span></label>
                <select asp-for="TypNieobecnosci" class="form-select">
                    <option value="">-- Wybierz typ nieobecności --</option>
                    @foreach (var typ in (List<string>)ViewData["TypyNieobecnosci"])
                    {
                        <option value="@typ">@typ</option>
                    }
                </select>
                <span asp-validation-for="TypNieobecnosci" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataOd" class="form-label">Data od <span class="text-danger">*</span></label>
                <input asp-for="DataOd" class="form-control" type="date" />
                <span asp-validation-for="DataOd" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataDo" class="form-label">Data do <span class="text-danger">*</span></label>
                <input asp-for="DataDo" class="form-control" type="date" />
                <span asp-validation-for="DataDo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Uwagi" class="form-label"></label>
                <textarea asp-for="Uwagi" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Uwagi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
