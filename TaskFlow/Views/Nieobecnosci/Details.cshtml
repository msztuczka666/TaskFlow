@model TaskFlow.Models.Nieobecnosc
@{
    ViewData["Title"] = "Szczegóły nieobecności";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Pracownik</dt>
            <dd class="col-sm-9">@Model.Pracownik.Imie @Model.Pracownik.Nazwisko</dd>

            <dt class="col-sm-3">Typ nieobecności</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.TypNieobecnosci</span></dd>

            <dt class="col-sm-3">Data od</dt>
            <dd class="col-sm-9">@Model.DataOd.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Data do</dt>
            <dd class="col-sm-9">@Model.DataDo.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Liczba dni</dt>
            <dd class="col-sm-9">@Model.LiczbaDni dni roboczych</dd>

            @if (Model.LiczbaGodzin.HasValue)
            {
                <dt class="col-sm-3">Liczba godzin</dt>
                <dd class="col-sm-9">@Model.LiczbaGodzin.Value godzin</dd>
            }

            <dt class="col-sm-3">Uwagi</dt>
            <dd class="col-sm-9">@(Model.Uwagi ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik") || User.IsInRole("Specjalista"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edytuj</a>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
    {
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Usuń</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
</div>
