@model IEnumerable<TaskFlow.Models.Nieobecnosc>
@{
    ViewData["Title"] = "Nieobecności";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Nieobecności</h1>
    <div>
        <a asp-action="Calendar" class="btn btn-info me-2">
            <i class="bi bi-calendar"></i> Kalendarz
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Kierownik") || User.IsInRole("Specjalista"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Dodaj nieobecność
            </a>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead class="table-dark">
                    <tr>
                        <th>Pracownik</th>
                        <th>Typ</th>
                        <th>Data od</th>
                        <th>Data do</th>
                        <th>Liczba dni</th>
                        <th>Uwagi</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-row-hover">
                            <td style="color: #e2e8f0;">@item.Pracownik.Imie @item.Pracownik.Nazwisko</td>
                            <td><span class="badge bg-secondary">@item.TypNieobecnosci</span></td>
                            <td style="color: #e2e8f0;">@item.DataOd.ToString("dd.MM.yyyy")</td>
                            <td style="color: #e2e8f0;">@item.DataDo.ToString("dd.MM.yyyy")</td>
                            <td style="color: #e2e8f0;">@item.LiczbaDni</td>
                            <td style="color: #e2e8f0;">@(item.Uwagi ?? "-")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik") || User.IsInRole("Specjalista"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edytuj</a>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Brak nieobecności w systemie.</div>
        }
    </div>
</div>

<style>
    .table-row-hover {
        transition: all 0.3s ease;
        background: rgba(71, 85, 105, 0.1);
    }
    .table-row-hover:hover {
        background: rgba(245, 158, 11, 0.15) !important;
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateX(2px);
    }
    .table-dark {
        background-color: #343a40;
        color: white;
    }
</style>
