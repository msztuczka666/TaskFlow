@model IEnumerable<TaskFlow.Models.Nieobecnosc>
@{
    ViewData["Title"] = "Nieobecności";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Nieobecności</h1>
    <div>
        <a asp-action="Calendar" class="btn btn-info me-2">
            <i class="bi bi-calendar"></i> Kalendarz
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Kierownik") || User.IsInRole("Specjalista"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Dodaj nieobecność
            </a>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Pracownik</th>
                        <th>Typ</th>
                        <th>Data od</th>
                        <th>Data do</th>
                        <th>Liczba dni</th>
                        <th>Uwagi</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Pracownik.Imie @item.Pracownik.Nazwisko</td>
                            <td><span class="badge bg-secondary">@item.TypNieobecnosci</span></td>
                            <td>@item.DataOd.ToString("dd.MM.yyyy")</td>
                            <td>@item.DataDo.ToString("dd.MM.yyyy")</td>
                            <td>@item.LiczbaDni</td>
                            <td>@(item.Uwagi ?? "-")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik") || User.IsInRole("Specjalista"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edytuj</a>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Brak nieobecności w systemie.</div>
        }
    </div>
</div>
