@model TaskFlow.Models.Pracownik
@{
    ViewData["Title"] = "Dodaj pracownika";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-10">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Imie" class="form-label"></label>
                    <input asp-for="Imie" class="form-control" maxlength="30" required />
                    <span asp-validation-for="Imie" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nazwisko" class="form-label"></label>
                    <input asp-for="Nazwisko" class="form-control" maxlength="50" required />
                    <span asp-validation-for="Nazwisko" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Firma" class="form-label"></label>
                    <input asp-for="Firma" class="form-control" maxlength="30" />
                    <span asp-validation-for="Firma" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NrPrzepustki" class="form-label"></label>
                    <input asp-for="NrPrzepustki" class="form-control" maxlength="10" pattern="\d*" />
                    <span asp-validation-for="NrPrzepustki" class="text-danger"></span>
                    <small class="form-text text-muted">Tylko cyfry, maksymalnie 10</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MPK" class="form-label"></label>
                    <input asp-for="MPK" class="form-control" maxlength="3" pattern="\d{3}" />
                    <span asp-validation-for="MPK" class="text-danger"></span>
                    <small class="form-text text-muted">Dokładnie 3 cyfry</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FirmaId" class="form-label"></label>
                    <input asp-for="FirmaId" class="form-control" maxlength="30" />
                    <span asp-validation-for="FirmaId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Stanowisko" class="form-label"></label>
                    <input asp-for="Stanowisko" class="form-control" maxlength="30" />
                    <span asp-validation-for="Stanowisko" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SEPNr" class="form-label"></label>
                    <input asp-for="SEPNr" class="form-control" maxlength="20" />
                    <span asp-validation-for="SEPNr" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DataWaznosciSEP" class="form-label"></label>
                    <input asp-for="DataWaznosciSEP" class="form-control" type="date" />
                    <span asp-validation-for="DataWaznosciSEP" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SEPNapiecie" class="form-label"></label>
                    <input asp-for="SEPNapiecie" class="form-control" maxlength="20" />
                    <span asp-validation-for="SEPNapiecie" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="LiczbaDniWolnych" class="form-label"></label>
                    <input asp-for="LiczbaDniWolnych" class="form-control" type="number" min="0" max="999" />
                    <span asp-validation-for="LiczbaDniWolnych" class="text-danger"></span>
                    <small class="form-text text-muted">Urlop wypoczynkowy</small>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="LiczbaDniNaZeszycie" class="form-label"></label>
                    <input asp-for="LiczbaDniNaZeszycie" class="form-control" type="number" min="0" max="999" />
                    <span asp-validation-for="LiczbaDniNaZeszycie" class="text-danger"></span>
                    <small class="form-text text-muted">Urlop zeszyt</small>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="LiczbaDniWykorzystanych" class="form-label"></label>
                    <input asp-for="LiczbaDniWykorzystanych" class="form-control" type="number" min="0" max="999" />
                    <span asp-validation-for="LiczbaDniWykorzystanych" class="text-danger"></span>
                    <small class="form-text text-muted">Wykorzystane dni urlopu</small>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="LiczbaDniNaZadanie" class="form-label"></label>
                    <input asp-for="LiczbaDniNaZadanie" class="form-control" type="number" min="0" max="4" />
                    <span asp-validation-for="LiczbaDniNaZadanie" class="text-danger"></span>
                    <small class="form-text text-muted">Max 4 dni w roku</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TypPracownika" class="form-label"></label>
                    <select asp-for="TypPracownika" class="form-select" required>
                        <option value="">-- Wybierz typ --</option>
                        <option value="Pracownik">Pracownik</option>
                        <option value="Nadzór">Nadzór</option>
                    </select>
                    <span asp-validation-for="TypPracownika" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="StawkaZlH" class="form-label"></label>
                    <input asp-for="StawkaZlH" class="form-control" type="number" step="0.01" min="0" max="999999.99" />
                    <span asp-validation-for="StawkaZlH" class="text-danger"></span>
                    <small class="form-text text-muted">Stawka w PLN/h</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StanZatrudnienia" class="form-label"></label>
                    <select asp-for="StanZatrudnienia" class="form-select" required>
                        <option value="">-- Wybierz stan --</option>
                        <option value="Zatrudniony" selected>Zatrudniony</option>
                        <option value="Zwolniony">Zwolniony</option>
                    </select>
                    <span asp-validation-for="StanZatrudnienia" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Informacje" class="form-label"></label>
                    <input asp-for="Informacje" class="form-control" maxlength="50" />
                    <span asp-validation-for="Informacje" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
