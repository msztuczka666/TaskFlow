@model TaskFlow.Models.Pracownik
@{
    ViewData["Title"] = "Edytuj pracownika";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Imie" class="form-label"></label>
                <input asp-for="Imie" class="form-control" />
                <span asp-validation-for="Imie" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nazwisko" class="form-label"></label>
                <input asp-for="Nazwisko" class="form-control" />
                <span asp-validation-for="Nazwisko" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FirmaGlowna" class="form-label"></label>
                <input asp-for="FirmaGlowna" class="form-control" />
                <span asp-validation-for="FirmaGlowna" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FirmaIdentyfikatorowa" class="form-label"></label>
                <input asp-for="FirmaIdentyfikatorowa" class="form-control" />
                <span asp-validation-for="FirmaIdentyfikatorowa" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DataWaznosciSEP" class="form-label"></label>
                <input asp-for="DataWaznosciSEP" class="form-control" type="date" />
                <span asp-validation-for="DataWaznosciSEP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
