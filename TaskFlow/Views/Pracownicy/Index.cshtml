@model IEnumerable<TaskFlow.Models.Pracownik>
@{
    ViewData["Title"] = "Pracownicy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pracownicy</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Dodaj pracownika
        </a>
    }
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Imię</th>
                        <th>Nazwisko</th>
                        <th>Firma</th>
                        <th>Nr przepustki</th>
                        <th>MPK</th>
                        <th>Firma ID</th>
                        <th>Stanowisko</th>
                        <th>SEP nr</th>
                        <th>SEP ważne do</th>
                        <th>Status SEP</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Imie</td>
                            <td>@item.Nazwisko</td>
                            <td>@item.Firma</td>
                            <td>@item.NrPrzepustki</td>
                            <td>@item.MPK</td>
                            <td>@item.FirmaId</td>
                            <td>@item.Stanowisko</td>
                            <td>@item.SEPNr</td>
                            <td>@(item.DataWaznosciSEP?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>
                                @if (item.DataWaznosciSEP.HasValue)
                                {
                                    if (item.CzySEPWazny)
                                    {
                                        <span class="badge bg-success">Ważny</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Wygasł</span>
                                    }
                                    @if (item.DniDoWygasniecia >= 0 && item.DniDoWygasniecia <= 30)
                                    {
                                        <span class="badge bg-warning text-dark">@item.DniDoWygasniecia dni</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Brak danych</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edytuj</a>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Brak pracowników w systemie.</div>
        }
    </div>
</div>
