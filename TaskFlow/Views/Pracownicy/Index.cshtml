@model IEnumerable<TaskFlow.Models.Pracownik>
@{
    ViewData["Title"] = "Pracownicy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pracownicy</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Dodaj pracownika
        </a>
    }
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead class="table-dark">
                    <tr>
                        <th>Imię</th>
                        <th>Nazwisko</th>
                        <th>Firma</th>
                        <th>Nr przepustki</th>
                        <th>MPK</th>
                        <th>Firma Id</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-row-hover">
                            <td>@item.Imie</td>
                            <td>@item.Nazwisko</td>
                            <td>@(item.Firma ?? "-")</td>
                            <td>@(item.NrPrzepustki ?? "-")</td>
                            <td>@(item.MPK ?? "-")</td>
                            <td>@(item.FirmaId ?? "-")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark">Edycja</a>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Brak pracowników w systemie.</div>
        }
    </div>
</div>

<style>
    .table-row-hover {
        transition: all 0.3s ease;
        background: #ffffff;
        color: #212529;
    }
    .table-row-hover:hover {
        background: rgba(245, 158, 11, 0.15) !important;
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateX(2px);
    }
    .table-dark {
        background-color: #343a40;
        color: white;
    }
    .table-row-hover td {
        color: #212529;
    }
</style>
