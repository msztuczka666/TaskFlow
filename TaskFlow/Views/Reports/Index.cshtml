@{
    ViewData["Title"] = "Raporty";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">📊 Raporty</h1>
            <p class="lead">Dynamiczne raporty z danych w systemie TaskFlow</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Report 1: Employee Hours -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">👥 Ilość godzin pracowników</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        Raport pokazujący ilość godzin przepracowanych przez pracowników w wybranych okresach.
                    </p>
                    <ul class="small">
                        <li>Filtrowanie: Rok, Miesiąc, MPK, Firma</li>
                        <li>Lista pracowników z godzinami dziennie</li>
                        <li>Bez mnożników nadgodzin</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("EmployeeHours", "Reports")" class="btn btn-primary w-100">
                        <i class="bi bi-file-earmark-bar-graph"></i> Otwórz raport
                    </a>
                </div>
            </div>
        </div>

        <!-- Report 2: Order Hours -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">📋 Ilość godzin na zleceniach</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        Raport pokazujący łączną liczbę godzin przepracowanych na poszczególnych zleceniach.
                    </p>
                    <ul class="small">
                        <li>Filtrowanie: Rok, Miesiąc, MPK, Firma</li>
                        <li>Lista zleceń z sumą godzin</li>
                        <li>Bez mnożników nadgodzin</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("OrderHours", "Reports")" class="btn btn-success w-100">
                        <i class="bi bi-clipboard-data"></i> Otwórz raport
                    </a>
                </div>
            </div>
        </div>

        <!-- Report 3: Vacation Balance -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">🏖️ Bilans dni wolnych</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        Raport pokazujący przysługujące, wykorzystane i pozostałe dni urlopu wypoczynkowego.
                    </p>
                    <ul class="small">
                        <li>Filtrowanie: Rok, MPK, Firma</li>
                        <li>Lista pracowników z bilansem dni</li>
                        <li>Tylko urlop wypoczynkowy</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("VacationBalance", "Reports")" class="btn btn-info w-100">
                        <i class="bi bi-calendar-check"></i> Otwórz raport
                    </a>
                </div>
            </div>
        </div>

        <!-- Report 4: Order Settlement -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">💰 Rozliczanie zlecenia</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        Raport rozliczenia kosztów pracy (godziny × stawka) z podziałem na prowadzone prace.
                    </p>
                    <ul class="small">
                        <li>Filtrowanie: Rok, Miesiąc, MPK, Firma, Nr zlecenia</li>
                        <li>Godziny × stawka pracownika</li>
                        <li>Podział na "Prowadzone prace"</li>
                        <li>Bez mnożników nadgodzin</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("OrderSettlement", "Reports")" class="btn btn-warning w-100">
                        <i class="bi bi-currency-exchange"></i> Otwórz raport
                    </a>
                </div>
            </div>
        </div>

        <!-- Report 5: Employee Overtime -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">⏰ Ilość nadgodzin pracowników</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        Raport nadgodzin z mnożnikami według stref czasowych i dni tygodnia.
                    </p>
                    <ul class="small">
                        <li>Filtrowanie: Rok, Miesiąc, MPK, Firma</li>
                        <li>Strefy czasowe: 6:30-14:30 (×1.0), 14:30-21:00 (×1.5), 21:00-6:30 (×2.0)</li>
                        <li>Sobota: ×1.5, Niedziela/Święto: ×2.0</li>
                        <li>Tylko nadgodziny</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("EmployeeOvertime", "Reports")" class="btn btn-danger w-100">
                        <i class="bi bi-clock-history"></i> Otwórz raport
                    </a>
                </div>
            </div>
        </div>
    </div>


</div>
