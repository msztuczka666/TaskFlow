@model IEnumerable<TaskFlow.Models.AuditLog>

@{
    ViewData["Title"] = "Historia zmian (Audit Log)";
}

<h1>📋 Historia zmian (Audit Log)</h1>

<div class="card mt-4">
    <div class="card-header">
        <h3>Filtry</h3>
    </div>
    <div class="card-body">
        <form asp-action="AuditLog" method="get" class="row g-3">
            <div class="col-md-3">
                <label for="action" class="form-label">Akcja</label>
                <select name="action" id="action" class="form-select">
                    <option value="">Wszystkie</option>
                    @foreach (var act in ViewBag.Actions)
                    {
                        <option value="@act" selected="@(ViewBag.Action == act)">@act</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="entity" class="form-label">Typ encji</label>
                <select name="entity" id="entity" class="form-select">
                    <option value="">Wszystkie</option>
                    @foreach (var ent in ViewBag.Entities)
                    {
                        <option value="@ent" selected="@(ViewBag.Entity == ent)">@ent</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="from" class="form-label">Data od</label>
                <input type="date" name="from" id="from" class="form-control" value="@(ViewBag.From?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label for="to" class="form-label">Data do</label>
                <input type="date" name="to" id="to" class="form-control" value="@(ViewBag.To?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">🔍 Filtruj</button>
                <a asp-action="AuditLog" class="btn btn-secondary">Wyczyść filtry</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Powrót do ustawień</a>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.TotalItems > 0)
{
    <div class="card mt-4">
        <div class="card-header">
            <h3>Znaleziono: @ViewBag.TotalItems wpisów</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Data i czas</th>
                            <th>Użytkownik</th>
                            <th>Akcja</th>
                            <th>Typ encji</th>
                            <th>ID encji</th>
                            <th>IP</th>
                            <th>Przeglądarka</th>
                            <th>Szczegóły</th>
                        </tr>
                    </thead>
                    <tbody style="color: #e2e8f0;">
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.UserName</td>
                                <td>
                                    @if (log.Action == "Create")
                                    {
                                        <span class="badge bg-success">@log.Action</span>
                                    }
                                    else if (log.Action == "Update")
                                    {
                                        <span class="badge bg-warning">@log.Action</span>
                                    }
                                    else if (log.Action == "Delete")
                                    {
                                        <span class="badge bg-danger">@log.Action</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@log.Action</span>
                                    }
                                </td>
                                <td>@log.EntityType</td>
                                <td>@(log.EntityId?.ToString() ?? "-")</td>
                                <td>@(log.IpAddress ?? "-")</td>
                                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;" title="@(log.UserAgent ?? "-")">
                                    @(log.UserAgent ?? "-")
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.Description))
                                    {
                                        <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#detailsModal_@log.Id">
                                            Pokaż
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Brak</span>
                                    }
                                </td>
                            </tr>

                            @* Details Modal *@
                            <div class="modal fade" id="detailsModal_@log.Id" tabindex="-1" aria-labelledby="detailsModalLabel_@log.Id" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="detailsModalLabel_@log.Id">Szczegóły zmiany</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body" style="color: #212529;">
                                            <h6>Informacje podstawowe:</h6>
                                            <table class="table table-sm">
                                                <tr><td><strong>Data i czas:</strong></td><td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
                                                <tr><td><strong>Użytkownik:</strong></td><td>@log.UserName (@log.UserId)</td></tr>
                                                <tr><td><strong>Akcja:</strong></td><td>@log.Action</td></tr>
                                                <tr><td><strong>Typ encji:</strong></td><td>@log.EntityType</td></tr>
                                                <tr><td><strong>ID encji:</strong></td><td>@(log.EntityId?.ToString() ?? "-")</td></tr>
                                                <tr><td><strong>IP:</strong></td><td>@(log.IpAddress ?? "-")</td></tr>
                                            </table>

                                            @if (!string.IsNullOrEmpty(log.Description))
                                            {
                                                <h6 class="mt-3">Opis:</h6>
                                                <pre style="white-space: pre-wrap; background: #f8f9fa; padding: 10px; border-radius: 5px;">@log.Description</pre>
                                            }

                                            @if (!string.IsNullOrEmpty(log.OldValues))
                                            {
                                                <h6 class="mt-3">Stare wartości (JSON):</h6>
                                                <pre style="white-space: pre-wrap; background: #f8f9fa; padding: 10px; border-radius: 5px; max-height: 200px; overflow-y: auto;">@log.OldValues</pre>
                                            }

                                            @if (!string.IsNullOrEmpty(log.NewValues))
                                            {
                                                <h6 class="mt-3">Nowe wartości (JSON):</h6>
                                                <pre style="white-space: pre-wrap; background: #f8f9fa; padding: 10px; border-radius: 5px; max-height: 200px; overflow-y: auto;">@log.NewValues</pre>
                                            }
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zamknij</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination *@
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Nawigacja po stronach">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="AuditLog" asp-route-page="@(ViewBag.CurrentPage - 1)" 
                                   asp-route-action="@ViewBag.Action" asp-route-entity="@ViewBag.Entity" 
                                   asp-route-from="@(ViewBag.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(ViewBag.To?.ToString("yyyy-MM-dd"))">
                                    Poprzednia
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="AuditLog" asp-route-page="@i"
                                   asp-route-action="@ViewBag.Action" asp-route-entity="@ViewBag.Entity" 
                                   asp-route-from="@(ViewBag.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(ViewBag.To?.ToString("yyyy-MM-dd"))">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="AuditLog" asp-route-page="@(ViewBag.CurrentPage + 1)"
                                   asp-route-action="@ViewBag.Action" asp-route-entity="@ViewBag.Entity" 
                                   asp-route-from="@(ViewBag.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(ViewBag.To?.ToString("yyyy-MM-dd"))">
                                    Następna
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                <p class="text-center text-muted">
                    Strona @ViewBag.CurrentPage z @ViewBag.TotalPages (łącznie @ViewBag.TotalItems wpisów)
                </p>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info mt-4">
        <strong>Brak wpisów w historii zmian.</strong>
        @if (!string.IsNullOrEmpty(ViewBag.Action) || !string.IsNullOrEmpty(ViewBag.Entity) || ViewBag.From != null || ViewBag.To != null)
        {
            <p class="mb-0 mt-2">Spróbuj zmienić kryteria filtrowania lub <a asp-action="AuditLog">wyczyść filtry</a>.</p>
        }
        else
        {
            <p class="mb-0 mt-2">System zacznie rejestrować zmiany od następnej operacji CRUD (tworzenie, edycja, usuwanie).</p>
        }
    </div>
}

<style>
    .table-row-hover {
        transition: all 0.3s ease;
        background: rgba(71, 85, 105, 0.1);
    }
    .table-row-hover:hover {
        background: rgba(245, 158, 11, 0.15) !important;
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateX(2px);
    }
    .table-dark {
        background-color: #343a40;
        color: white;
    }
</style>

@section Scripts {
    <script>
        // Apply hover effect to table rows
        document.querySelectorAll('tbody tr').forEach(row => {
            row.classList.add('table-row-hover');
        });
    </script>
}
