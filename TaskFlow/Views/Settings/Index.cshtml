            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Theme toggle functionality
        document.getElementById('themeToggle').addEventListener('change', function() {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'alert alert-info alert-dismissible fade show mt-3';
            messageDiv.innerHTML = this.checked ? 
                'Tryb ciemny jest już aktywny. <button type="button" class="btn-close" data-bs-dismiss="alert"></button>' :
                'Tryb jasny będzie dostępny wkrótce. <button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
            
            const container = document.querySelector('.card-body');
            const existingAlert = container.querySelector('.alert');
            if (existingAlert && !existingAlert.classList.contains('alert-info')) {
                container.insertBefore(messageDiv, existingAlert);
            }
            
            // Keep dark mode for now
            this.checked = true;
        });
    </script>
}
