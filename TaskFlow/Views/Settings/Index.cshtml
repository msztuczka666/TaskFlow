@{
    ViewData["Title"] = "Ustawienia";
}

<h1>⚙️ Ustawienia</h1>

<div class="row mt-4">
    <div class="col-md-8">
        <!-- Theme Settings -->
        <div class="card">
            <div class="card-header">
                <h3>Wygląd</h3>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label class="form-label fw-bold">Motyw kolorystyczny</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="themeToggle" checked>
                        <label class="form-check-label" for="themeToggle">
                            Tryb ciemny
                        </label>
                    </div>
                    <small class="text-muted">Przełączaj między trybem ciemnym a jasnym</small>
                </div>
                
                <div class="alert alert-info">
                    <strong>Uwaga:</strong> Funkcjonalność przełączania motywu zostanie wkrótce w pełni wdrożona. Obecnie system działa w trybie ciemnym.
                </div>
            </div>
        </div>

        <!-- User Management (Admin Only) -->
        @if (User.IsInRole("Admin"))
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h3>Zarządzanie użytkownikami</h3>
                </div>
                <div class="card-body">
                    <p>Zarządzaj użytkownikami systemu - dodawaj, edytuj i usuwaj konta użytkowników.</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-primary">
                        👥 Przejdź do zarządzania użytkownikami
                    </a>
                    
                    <div class="alert alert-info mt-3">
                        <strong>Informacja o uprawnieniach:</strong>
                        <ul class="mb-0 mt-2">
                            <li><strong>Administrator</strong> - Pełny dostęp do systemu, w tym zarządzanie użytkownikami</li>
                            <li><strong>Mistrz / Specjalista</strong> - Dostęp do edycji i zapisów danych</li>
                            <li><strong>Kierownik budowy / działu</strong> - Dostęp do raportów i zarządzania zespołem</li>
                            <li><strong>Gość</strong> - Dostęp tylko do odczytu</li>
                        </ul>
                    </div>
                </div>
            </div>
        }

        <!-- System Information -->
        <div class="card mt-3">
            <div class="card-header">
                <h3>Informacje o systemie</h3>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <td><strong>Wersja:</strong></td>
                            <td>1.0.0</td>
                        </tr>

                    </tbody>
                </table>
                
                <div class="mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#licenseModal">
                        <i class="bi bi-file-text"></i> Umowa licencyjna
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

