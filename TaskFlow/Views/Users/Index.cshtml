@model IEnumerable<TaskFlow.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Zarządzanie użytkownikami";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">➕ Dodaj użytkownika</a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table">
            <thead class="table-dark">
                <tr>
                    <th>Imię</th>
                    <th>Nazwisko</th>
                    <th>Email</th>
                    <th>Stanowisko</th>
                    <th>Role</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="table-row-hover">
                        <td style="color: #e2e8f0;">@user.Imie</td>
                        <td style="color: #e2e8f0;">@user.Nazwisko</td>
                        <td style="color: #e2e8f0;">@user.Email</td>
                        <td style="color: #e2e8f0;">
                            @if (!string.IsNullOrEmpty(user.Stanowisko))
                            {
                                <span class="badge bg-info">@user.Stanowisko</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Brak</span>
                            }
                        </td>
                        <td style="color: #e2e8f0;">
                            @if (!string.IsNullOrEmpty(user.Roles))
                            {
                                foreach (var role in user.Roles.Split(", "))
                                {
                                    <span class="badge @(role == "Admin" ? "bg-danger" : role == "Kierownik" ? "bg-warning" : "bg-success")">@role</span>
                                }
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">✏️ Edytuj</a>
                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">🗑️ Usuń</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .table-row-hover {
        transition: all 0.3s ease;
        background: rgba(71, 85, 105, 0.1);
    }
    .table-row-hover:hover {
        background: rgba(245, 158, 11, 0.15) !important;
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateX(2px);
    }
    .table-dark {
        background-color: #343a40;
        color: white;
    }
</style>
