@model TaskFlow.Models.Zlecenie
@{
    ViewData["Title"] = "Usuń zlecenie";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <h4>Czy na pewno chcesz usunąć to zlecenie?</h4>
    <p>Ta operacja jest nieodwracalna.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.NrZlecenia)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.NrZlecenia)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Opis)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Opis)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DataRozpoczecia)
            </dt>
            <dd class="col-sm-9">
                @Model.DataRozpoczecia.ToString("dd.MM.yyyy")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DataZakonczenia)
            </dt>
            <dd class="col-sm-9">
                @Model.DataZakonczenia.ToString("dd.MM.yyyy")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.LiczbaDniRoboczych)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.LiczbaDniRoboczych) dni
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Status)
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Potwierdź usunięcie</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>
