@model TaskFlow.Models.Zlecenie
@{
    ViewData["Title"] = "Edycja zlecenia";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-3">
                <label asp-for="NrZlecenia" class="form-label"></label>
                <input asp-for="NrZlecenia" class="form-control" maxlength="30" />
                <span asp-validation-for="NrZlecenia" class="text-danger"></span>
                <small class="form-text text-muted">Maksymalnie 30 znaków</small>
            </div>
            
            <div class="mb-3">
                <label asp-for="Opis" class="form-label"></label>
                <textarea asp-for="Opis" class="form-control" rows="3" maxlength="110"></textarea>
                <span asp-validation-for="Opis" class="text-danger"></span>
                <small class="form-text text-muted">Maksymalnie 110 znaków</small>
            </div>
            
            <div class="mb-3">
                <label asp-for="DataRozpoczecia" class="form-label"></label>
                <input asp-for="DataRozpoczecia" class="form-control" type="date" />
                <span asp-validation-for="DataRozpoczecia" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="DataZakonczenia" class="form-label"></label>
                <input asp-for="DataZakonczenia" class="form-control" type="date" />
                <span asp-validation-for="DataZakonczenia" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var status in ViewBag.Statusy)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Informacje" class="form-label"></label>
                <textarea asp-for="Informacje" class="form-control" rows="3" maxlength="110"></textarea>
                <span asp-validation-for="Informacje" class="text-danger"></span>
                <small class="form-text text-muted">Maksymalnie 110 znaków</small>
            </div>
            
            <div class="alert alert-info">
                <strong>Uwaga:</strong> Zmiana numeru zlecenia lub innych danych automatycznie zaktualizuje wszystkie powiązane wpisy w dzienniku godzin.
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
