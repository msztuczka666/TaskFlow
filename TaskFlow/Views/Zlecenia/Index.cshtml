@model IEnumerable<TaskFlow.Models.Zlecenie>
@{
    ViewData["Title"] = "Zlecenia";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Zlecenia</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Dodaj zlecenie
        </a>
    }
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead class="table-dark">
                    <tr>
                        <th>Nr zlecenia</th>
                        <th>Opis zlecenia</th>
                        <th>Ilość dni</th>
                        <th>Status</th>
                        <th>Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-row-hover">
                            <td>@item.NrZlecenia</td>
                            <td>@item.Opis</td>
                            <td>@item.LiczbaDniRoboczych</td>
                            <td>
                                @if (item.Status == "Aktywne")
                                {
                                    <span class="badge bg-success">Aktywne</span>
                                }
                                else if (item.Status == "Zakończone")
                                {
                                    <span class="badge bg-secondary">Zakończone</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@item.Status</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Szczegóły</a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik") || User.IsInRole("Specjalista"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark">Edycja</a>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Kierownik"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Usuń</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Brak zleceń w systemie.</div>
        }
    </div>
</div>

<style>
    .table-row-hover {
        transition: all 0.3s ease;
        background: #ffffff;
        color: #212529;
    }
    .table-row-hover:hover {
        background: rgba(245, 158, 11, 0.15) !important;
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateX(2px);
    }
    .table-dark {
        background-color: #343a40;
        color: white;
    }
    .table-row-hover td {
        color: #212529;
    }
</style>
